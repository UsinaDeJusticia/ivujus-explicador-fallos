# Servidor — NUNCA exponer en el navegador (sin NEXT_PUBLIC_)
OPENROUTER_API_KEY=

# Modelo principal (gratis). Fallback automático vía parámetro `models` de OpenRouter.
EXPLICADOR_MODEL=google/gemma-4-31b-it:free
# EXPLICADOR_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free

# Orígenes permitidos (coma-separados). Vacío = permitir (útil en local).
# En producción: https://tu-dominio.vercel.app,https://usinadejusticia.org.ar
ALLOWED_ORIGINS=http://localhost:3000

# Opcional cliente
# NEXT_PUBLIC_ENABLE_NER=false
