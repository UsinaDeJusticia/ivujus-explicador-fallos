# Clave de OpenRouter (solo servidor; nunca en el cliente)
OPENROUTER_API_KEY=

# Modelo OpenRouter (default: mistralai/mistral-nemo)
EXPLICADOR_MODEL=mistralai/mistral-nemo

# Orígenes permitidos para CORS, separados por coma.
# Ejemplo: https://tusitio.org,http://localhost:3000
# Usá * solo en desarrollo.
ALLOWED_ORIGINS=
