# Servidor — NUNCA exponer en el navegador (sin NEXT_PUBLIC_)
# Obligatorio para que /api/llm funcione. Si está vacío → 503 y no se envía nada.
OPENROUTER_API_KEY=

# Opcional. Default en código: google/gemma-4-31b-it:free
EXPLICADOR_MODEL=google/gemma-4-31b-it:free

# Opcional. Default en código: google/gemma-4-26b-a4b-it:free
# EXPLICADOR_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free

# Opcional. Orígenes CORS permitidos (coma-separados).
# Vacío = el proxy permite (útil en local). En producción conviene restringir.
ALLOWED_ORIGINS=http://localhost:3000
# Ejemplo producción:
# ALLOWED_ORIGINS=https://ivujus-explicador-fallos.vercel.app
